# Copy to .env and fill in what you use. Restart Akari after changes.

PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to serve other devices (then set APP_PASSWORD).
HOST=127.0.0.1
# The address you open Akari at. Tracker redirect URLs are built from this.
PUBLIC_URL=http://localhost:3000
# Browser sign-in password for the whole site (any username). Strongly recommended on a server.
APP_PASSWORD=

# GitHub: optional for public repos (raises the rate limit), required for private ones.
# Fine-grained token with read-only "Contents" access to the repos you add.
GITHUB_TOKEN=

# AniList: https://anilist.co/settings/developer → Create new client
# Redirect URL: <PUBLIC_URL>/auth/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MyAnimeList: https://myanimelist.net/apiconfig → Create ID (App Type: web)
# App Redirect URL: <PUBLIC_URL>/auth/mal/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Kitsu needs no app registration; sign in from Settings.
KITSU_API_BASE=https://kitsu.app/api

# Set to true to load the bundled Blender open-movie sample (for testing the player).
ENABLE_SAMPLE=false
